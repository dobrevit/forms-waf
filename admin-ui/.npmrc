# Supply-chain hardening.
# ignore-scripts: never execute package lifecycle scripts (install/postinstall) —
#   the primary RCE vector in npm supply-chain attacks.
# min-release-age: refuse any version published less than N days ago, so a freshly
#   published malicious release is not installed before it can be caught/yanked.
#   REQUIRES npm >= 11 (node:22-alpine ships npm 10.9.8 and IGNORES this silently).
ignore-scripts=true
min-release-age=7
